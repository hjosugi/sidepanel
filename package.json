{
  "name": "sidepanel-bookmarks",
  "version": "1.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Bookmarks in the Chrome side panel, with sites opened inside the panel.",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs && biome check .",
    "format": "biome check --write .",
    "test": "node scripts/smoke-test.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "compat": "node scripts/compat-check.mjs",
    "release:check": "pnpm run lint && pnpm run test:unit && pnpm run test",
    "release:package": "node scripts/package-extension.mjs",
    "release:zip": "pnpm run release:check && pnpm run release:package",
    "release:store:assets": "node scripts/generate-store-assets.mjs",
    "release:store:status": "node scripts/chrome-webstore.mjs status",
    "release:store:upload": "node scripts/chrome-webstore.mjs upload",
    "release:store:publish": "node scripts/chrome-webstore.mjs publish",
    "release:store:submit": "node scripts/chrome-webstore.mjs submit",
    "release:store:cancel": "node scripts/chrome-webstore.mjs cancel",
    "release:store": "pnpm run release:zip && pnpm run release:store:submit",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
