{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**/*.js", "**/*.mjs", "**/*.json", "**/*.css", "!node_modules", "!dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" },
    "globals": ["chrome"]
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  }
}
